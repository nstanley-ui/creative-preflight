/* Minimal styling for the demo UI */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px;
}

.grid {
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 18px;
  align-items: start;
}

.card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.05);
}

.form-group { margin-bottom: 12px; }

.row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

input[type="text"],
input[type="number"],
select {
  width: 100%;
  box-sizing: border-box;
  padding: 10px;
  border-radius: 10px;
  border: 1px solid #d1d5db;
  background: #fff;
}

.primary-btn, .secondary-btn, .magic-btn {
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid #d1d5db;
  cursor: pointer;
  font-weight: 700;
}

.primary-btn { background: #111827; color: white; border-color: #111827; width: 100%; }
.secondary-btn { background: #f3f4f6; color: #111827; }
.secondary-btn.small { padding: 8px 10px; }

.results-area { display: grid; gap: 16px; }

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.stat {
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 10px;
  background: #fff;
}

.stat.full-width { grid-column: 1 / -1; }

.label {
  display: block;
  font-size: 11px;
  letter-spacing: 0.06em;
  color: #6b7280;
  font-weight: 800;
  text-transform: uppercase;
}

.value {
  display: block;
  margin-top: 4px;
  font-size: 16px;
  font-weight: 800;
  color: #111827;
}

.value.PASS { color: #16a34a; }
.value.WARNING { color: #d97706; }
.value.BLOCKER { color: #dc2626; }

.magic-card { border: 1px solid #c7d2fe; background: #eef2ff; }
.magic-sub { margin-top: 4px; color: #4b5563; font-size: 13px; }
.before-after {
  display: grid;
  grid-template-columns: 1fr 40px 1fr;
  gap: 10px;
  align-items: center;
  margin-top: 12px;
}

.pane { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 10px; }
.pane-title { font-weight: 900; margin-bottom: 8px; }

.kv { display: flex; justify-content: space-between; gap: 10px; margin: 6px 0; font-size: 13px; }
.kv code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace; }

.arrow { text-align: center; font-size: 22px; font-weight: 900; color: #4f46e5; }

.magic-actions { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
.magic-btn { background: #4f46e5; color: #fff; border-color: #4f46e5; }
.magic-notes { color: #374151; font-weight: 700; font-size: 13px; }

.success-msg { margin-top: 12px; font-weight: 900; color: #16a34a; }
